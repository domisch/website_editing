make_igraph <- function(arg1) {
# Avoid exponential numbers in the reclassification --> set this only within the function
# options(scipen=999)
print(arg1)
return(arg1)
}
make_igraph(1)
make_igraph(1000000000000000)
make_igraph <- function(arg1) {
# Avoid exponential numbers in the reclassification --> set this only within the function
options(scipen=999)
print(arg1)
return(arg1)
}
make_igraph(1000000000000000)
